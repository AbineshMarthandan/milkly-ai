# ---------------------------------------------------------------------------
# Milkly AI — build-time configuration (copy to .env.local, never commit it)
#
# NOTHING in this file is a secret. A browser app cannot keep secrets: every
# VITE_* value is compiled into the public JavaScript bundle. Only put public
# identifiers here. Never put service-account keys or client secrets here.
# ---------------------------------------------------------------------------

# OAuth 2.0 *Web application* Client ID from Google Cloud Console.
# Public identifier (it is visible in every Google sign-in URL). Not a secret.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ID of the spreadsheet that acts as the database
# (the long token in https://docs.google.com/spreadsheets/d/<ID>/edit).
VITE_GOOGLE_SPREADSHEET_ID=

# Enables the "Try demo" mode that stores sample data in this browser only.
# Defaults to true in `npm run dev` and false in production builds.
VITE_ENABLE_DEMO_MODE=
